# Telegram Bot
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789
SUPPORT_URL=https://t.me/your_support

# Database
DATABASE_URL=postgresql+asyncpg://daggervpn:changeme@db:5432/daggervpn

# Redis (optional, for caching)
REDIS_URL=redis://redis:6379/0

# Remnawave API
REMNAWAVE_API_URL=https://your-panel.com/api
REMNAWAVE_API_TOKEN=your_remnawave_api_token
# Secret cookie the panel's nginx requires (name=value). Without it the panel
# closes the connection with no response (444). Leave empty if not used.
REMNAWAVE_PANEL_COOKIE=

# Payment Provider
PAYMENT_PROVIDER=platega
PLATEGA_MERCHANT_ID=your_merchant_id
PLATEGA_SECRET=your_secret_key

# App
LOG_LEVEL=INFO
BOT_USERNAME=your_bot_username
